page{background-color:#f5f5f5}.about-wrapper{padding:30rpx}.about-wrapper .header{background-color:#fff;border-radius:12rpx;padding:40rpx 30rpx;text-align:center;margin-bottom:24rpx}.about-wrapper .header .company-name{font-size:36rpx;font-weight:700;color:#333}.about-wrapper .info-section{background-color:#fff;border-radius:12rpx;padding:30rpx;margin-bottom:24rpx}.about-wrapper .info-section .section-title{font-size:30rpx;font-weight:700;color:#333;margin-bottom:24rpx;padding-bottom:20rpx;border-bottom:1rpx solid #eee}.about-wrapper .info-section .info-item{display:flex;align-items:flex-start;margin-bottom:20rpx;font-size:28rpx;line-height:1.6}.about-wrapper .info-section .info-item .label{color:#999;white-space:nowrap}.about-wrapper .info-section .info-item .value{color:#333;flex:1}.about-wrapper .info-section .scope-content{font-size:28rpx;color:#333;line-height:1.8}